{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wrkrs configuration (schema version 3)",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 3,
      "description": "Configuration schema version."
    },
    "preset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "const": "product-engineering",
          "description": "Framework preset identifier."
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Preset version the roster was generated from."
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string",
          "const": "claude-code",
          "description": "Primary runtime adapter identifier."
        }
      },
      "required": [
        "primary"
      ],
      "additionalProperties": false
    },
    "roster": {
      "type": "object",
      "properties": {
        "primaryRole": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Role that coordinates the others."
        },
        "roles": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Role identifier referenced by the runtime adapter."
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!\\/)(?!\\.\\.(\\/|$))(?!.*\\/\\.\\.(\\/|$))[^\\\\]+$",
                "description": "Repository-relative path of the portable role definition."
              },
              "specializations": {
                "description": "Task-specific specializations attached to this role.",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              }
            },
            "required": [
              "id",
              "source"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "primaryRole",
        "roles"
      ],
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "properties": {
        "requirePlanApproval": {
          "type": "boolean"
        },
        "requireDesignApproval": {
          "type": "boolean"
        },
        "requireOwnerTestForUserFacingOrNativeWork": {
          "type": "boolean"
        },
        "requireExplicitReleaseApproval": {
          "type": "boolean"
        }
      },
      "required": [
        "requirePlanApproval",
        "requireDesignApproval",
        "requireOwnerTestForUserFacingOrNativeWork",
        "requireExplicitReleaseApproval"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {},
      "description": "Explicit extension data preserved by wrkrs but not interpreted by it."
    },
    "execution": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "adaptive",
            "fast",
            "standard",
            "full"
          ],
          "description": "Execution profile floor: adaptive lets the Product Manager triage; fast, standard, and full set a floor that may be raised and never lowered."
        }
      },
      "required": [
        "profile"
      ],
      "additionalProperties": false
    },
    "connections": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "github",
                  "linear",
                  "figma",
                  "mcp"
                ]
              },
              "kind": {
                "type": "string",
                "const": "mcp-server"
              },
              "server": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "scope": {
                "type": "string",
                "enum": [
                  "project",
                  "user",
                  "local",
                  "cloud"
                ]
              },
              "note": {
                "type": "string",
                "maxLength": 120
              }
            },
            "required": [
              "provider",
              "kind",
              "server",
              "scope"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "const": "github"
              },
              "kind": {
                "type": "string",
                "const": "cli"
              },
              "executable": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "note": {
                "type": "string",
                "maxLength": 120
              }
            },
            "required": [
              "provider",
              "kind",
              "executable"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "const": "manual"
              },
              "kind": {
                "type": "string",
                "const": "manual"
              },
              "note": {
                "type": "string",
                "maxLength": 120
              }
            },
            "required": [
              "provider",
              "kind"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "Primary capability bindings. One route per Increment 3 read capability."
    }
  },
  "required": [
    "schemaVersion",
    "preset",
    "runtime",
    "roster",
    "governance",
    "extensions",
    "execution",
    "connections"
  ],
  "additionalProperties": false,
  "description": "wrkrs repository configuration"
}
